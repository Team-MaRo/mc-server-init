{
  "name": "mc-server-init",
  // Linux Rust toolchain (rustup + cargo + a working gcc/linker). This crate is
  // Linux-only (fork/openpty/signalfd), so it can't build on a Windows host —
  // develop it here and rust-analyzer/cargo target x86_64-unknown-linux-gnu.
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",

  // Pre-fetch crate deps so the first rust-analyzer/cargo run is fast.
  "postCreateCommand": "cargo fetch",

  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "jnoortheen.nix-ide"
      ]
    }
  }
}
